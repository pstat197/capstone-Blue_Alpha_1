      "layer": [
        {
          "mark": {
            "type": "bar",
            "size": 42
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "(datum.channel === 'BASELINE')",
                "value": "#F9AB00"
              },
              "value": "#1967D2"
            },
            "x": {
              "axis": {
                "domain": false,
                "format": "%",
                "labelPadding": 10,
                "tickCount": 5,
                "ticks": false
              },
              "field": "prev_sum",
              "title": "% Revenue",
              "type": "quantitative"
            },
            "x2": {
              "field": "sum_outcome"
            },
            "y": {
              "axis": {
                "domain": false,
                "labelLimit": 250,
                "labelPadding": 10,
                "ticks": false
              },
              "field": "channel",
              "scale": {
                "paddingOuter": 0.2
              },
              "sort": null,
              "title": null,
              "type": "nominal"
            }
          },
          "transform": [
            {
              "window": [
                {
                  "op": "sum",
                  "field": "pct_of_contribution",
                  "as": "sum_outcome"
                },
                {
                  "op": "lead",
                  "field": "channel",
                  "as": "kwargs"
                }
              ]
            },
            {
              "calculate": "datum.sum_outcome - datum.pct_of_contribution",
              "as": "prev_sum"
            },
            {
              "calculate": "datum.incremental_outcome < 0 ? datum.prev_sum : datum.sum_outcome",
              "as": "text_x"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "color": "#5F6368",
            "dx": 10,
            "fontSize": 14
          },
          "encoding": {
            "text": {
              "field": "outcome_text",
              "type": "nominal"
            },
            "x": {
              "field": "text_x",
              "type": "quantitative"
            },
            "y": {
              "axis": {
                "domain": false,
                "labelLimit": 250,
                "labelPadding": 10,
                "ticks": false
              },
              "field": "channel",
              "scale": {
                "paddingOuter": 0.2
              },
              "sort": null,
              "title": null,
              "type": "nominal"
            }
          },
          "transform": [
            {
              "window": [
                {
                  "op": "sum",
                  "field": "pct_of_contribution",
                  "as": "sum_outcome"
                },
                {
                  "op": "lead",
                  "field": "channel",
                  "as": "kwargs"
                }
              ]
            },
            {
              "calculate": "datum.sum_outcome - datum.pct_of_contribution",
              "as": "prev_sum"
            },
            {
              "calculate": "datum.incremental_outcome < 0 ? datum.prev_sum : datum.sum_outcome",
              "as": "text_x"
            }
          ]
        }
      ],
